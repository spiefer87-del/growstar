[Unit]
Description=Growstar Spider Farmer isolated network boundary (SF.1N)
After=NetworkManager.service network-online.target
Wants=network-online.target
Requires=NetworkManager.service

[Service]
Type=oneshot
RemainAfterExit=yes
Environment="GROWSTAR_PROJECT_DIR=__GROWSTAR_DIR__"
Environment="GROWSTAR_SF_NETWORK_CONFIG=__SF_NETWORK_CONFIG__"
Environment="GROWSTAR_SF_NETWORK_STATE=__SF_NETWORK_STATE__"
ExecStart=/usr/local/libexec/growstar-spiderfarmer-network start
ExecStop=/usr/local/libexec/growstar-spiderfarmer-network stop
TimeoutStartSec=60
TimeoutStopSec=45

# Root is required only for NetworkManager/nftables. The executable is fixed,
# root-owned and accepts no shell snippets.
User=root
Group=root
UMask=0077
NoNewPrivileges=yes
PrivateTmp=yes
ProtectSystem=full
ProtectHome=read-only
ReadWritePaths=__SF_NETWORK_DIR__ /etc/NetworkManager/system-connections /run
RestrictAddressFamilies=AF_INET AF_INET6 AF_NETLINK AF_UNIX

[Install]
WantedBy=multi-user.target
